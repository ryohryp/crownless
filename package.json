{
  "name": "crownless",
  "version": "0.1.0",
  "private": true,
  "description": "Location-discovery expedition RPG in a medieval fantasy world",
  "scripts": {
    "start": "node scripts/serve-slice.cjs",
    "test": "node --test",
    "playtest": "node scripts/evaluate-playtest-jev.cjs",
    "playtest:browser": "node scripts/playtest-browser-jev.cjs",
    "playtest:browser:full": "node scripts/playtest-browser-jev.cjs --full",
    "playtest:smoke": "node scripts/playtest-browser-smoke.cjs && node scripts/verify-tower-bag-phone.cjs",
    "playtest:pixel-forest": "node scripts/verify-pixel-forest.cjs",
    "asset:quality": "node scripts/asset-quality-gate.cjs"
  },
  "devDependencies": {
    "@typesafe-ai/sdk": "0.7.0",
    "sharp": "0.35.4"
  }
}
